# ResearchOps Backend Configuration Template
# Copy this file to .env and provide your actual API keys.
# NEVER commit .env to version control.

# External API Keys (Server-side only)
OPENROUTER_API_KEY=your_openrouter_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# Model Selection
# Research/Checker model: Low-cost fast reasoning (e.g., deepseek/deepseek-chat or similar)
RESEARCH_MODEL=deepseek/deepseek-chat
# Writer model: Higher capability for report synthesis (e.g., anthropic/claude-3.5-sonnet or similar)
WRITER_MODEL=anthropic/claude-3.5-sonnet

# Workflow Boundaries & Cost Limits
MAX_RESEARCH_RETRIES=2
MAX_SEARCHES_PER_JOB=3

# Server Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
